{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Local HAL API of the Planejamento Mensal desktop app. Start at GET /api.",
    "title" : "Planejamento Mensal API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "security" : [ {
    "sessionToken" : [ ]
  } ],
  "tags" : [ {
    "description" : "Members (contas / cotas): people or cost centres that own incomes, expenses and entries (RF-01, RF-20,\n RF-80).",
    "name" : "member-controller"
  }, {
    "description" : "Spending categories with colour, icon and optional parent (RF-06, RF-07, I18N-07).",
    "name" : "category-controller"
  }, {
    "description" : "Credit cards with finals, holder, default member and closing/due cycles (RF-02 to RF-05).",
    "name" : "card-controller"
  }, {
    "description" : "User settings (IMP-10): thresholds, auto-validation, spreadsheet and e-mail options, language.",
    "name" : "settings-controller"
  }, {
    "description" : "API entry point: the only URL the interface knows (API-07).",
    "name" : "root-controller"
  }, {
    "description" : "HAL profile that documents the custom link relations of the API (API-10).",
    "name" : "profile-controller"
  } ],
