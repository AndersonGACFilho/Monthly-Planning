  "components" : {
    "schemas" : {
      "ActivePatch" : {
        "type" : "object",
        "description" : "Partial change of the active flag of a member, card or category (RF-01).",
        "properties" : {
          "active" : {
            "type" : "boolean",
            "description" : "new state"
          }
        },
        "required" : [ "active" ]
      },
      "CardModel" : {
        "type" : "object",
        "description" : "HAL representation of a card.",
        "properties" : {
          "_links" : {
            "$ref" : "#/components/schemas/Links"
          },
          "active" : {
            "type" : "boolean",
            "description" : "Active flag."
          },
          "bank" : {
            "type" : "string",
            "description" : "Issuer.",
            "enum" : [ "ITAU" ]
          },
          "cycles" : {
            "type" : "array",
            "description" : "Cycles, oldest first; empty for additional cards.",
            "items" : {
              "$ref" : "#/components/schemas/Cycle"
            }
          },
          "defaultMemberId" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Default member."
          },
          "holderName" : {
            "type" : "string",
            "description" : "Holder name."
          },
          "id" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Id."
          },
          "lastDigits" : {
            "type" : "array",
            "description" : "Finals.",
            "items" : {
              "type" : "string"
            }
          },
          "nickname" : {
            "type" : "string",
            "description" : "Nickname."
          },
          "primaryCardId" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Primary card of an additional card."
          }
        }
      },
      "CardRequest" : {
